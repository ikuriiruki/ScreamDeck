{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ScreamDeck",
  "version": "0.1.0",
  "identifier": "com.ikuriiruki.screamdeck",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "ScreamDeck",
        "width": 420,
        "height": 680,
        "minWidth": 360,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/ikuriiruki/ScreamDeck/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM0MzI5RkY2RTQ2NzA1QTcKUldTbkJXZms5cDh5eEVNMGVDcEhZdXdXdTlIZVJpM0tYYmJVWjlXL0h4dXlaZTVTdFI1YTRrN0IK"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
