{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "autostart:default",
    "updater:default",
    "core:window:allow-set-theme",
    "allow-get-library",
    "allow-get-settings",
    "allow-get-status",
    "allow-save-screamer",
    "allow-delete-screamer",
    "allow-import-media",
    "allow-import-sound",
    "allow-discard-media",
    "allow-save-thumbnail",
    "allow-save-set",
    "allow-delete-set",
    "allow-set-enabled",
    "allow-trigger-test",
    "allow-stop",
    "allow-update-settings",
    "allow-reset-settings",
    "allow-list-monitors",
    "allow-inspect-data-dir",
    "allow-change-data-dir",
    "allow-open-data-dir",
    "allow-retry-data-dir",
    "allow-pick-free-port",
    "allow-export-bundle",
    "allow-inspect-bundle",
    "allow-import-bundle"
  ]
}
